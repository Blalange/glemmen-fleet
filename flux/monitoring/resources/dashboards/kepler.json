            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(((max by (node_name) (increase(kepler_node_cpu_joules_total{zone=~\"package|psys\", node_name=~\"$node\"}[$__range]))) or (sum by (node_name) (increase(kepler_node_cpu_joules_total{zone!~\"package|psys\", node_name=~\"$node\"}[$__range])) unless on (node_name) max by (node_name) (kepler_node_cpu_joules_total{zone=~\"package|psys\", node_name=~\"$node\"})))) / 3.6e6",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "title": "Energy (range)",
      "type": "stat",
      "description": "Energy consumed by the selected nodes over the dashboard time range, from Kepler's monotonic joule counters (converted to kWh)."
