    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(((max by (node_name) (kepler_node_cpu_watts{zone=~\"package|psys\", node_name=~\"$node\"})) or (sum by (node_name) (kepler_node_cpu_watts{zone!~\"package|psys\", node_name=~\"$node\"}) unless on (node_name) max by (node_name) (kepler_node_cpu_watts{zone=~\"package|psys\", node_name=~\"$node\"}))))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "title": "Cluster power",
      "type": "stat",
      "description": "Current CPU power summed over the selected nodes. RAPL nodes use the package zone; glemmen60's two hwmon socket zones are summed."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
