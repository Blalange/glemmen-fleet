  "description": "CPU power and energy consumption for the glemmen nodes, from Kepler. RAPL nodes use the highest-coverage package zone so overlapping zones are not double-counted; glemmen60's separate hwmon socket zones are summed. Pod values are Kepler's attribution and need not add up exactly to node power. glemmen50 and glemmen160 are excluded because they have no usable power sensor.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "collapsed": false,
