          "expr": "sum(((max by (node_name) (kepler_node_cpu_active_watts{zone=~\"package|psys\", node_name=~\"$node\"})) or (sum by (node_name) (kepler_node_cpu_active_watts{zone!~\"package|psys\", node_name=~\"$node\"}) unless on (node_name) max by (node_name) (kepler_node_cpu_active_watts{zone=~\"package|psys\", node_name=~\"$node\"}))))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
