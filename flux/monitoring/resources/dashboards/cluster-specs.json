    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.3.3"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "Hardware and capacity overview for the cluster: machine count, CPU cores, memory, raw physical disk capacity, usable capacity after RAID, and Longhorn capacity. The table breaks the same figures down per machine.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Cluster totals",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Number of nodes currently scraped by node-exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "count(node_uname_info)",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Total machines",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Logical CPU cores across all nodes (one idle series per core).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "count(node_cpu_seconds_total{mode=\"idle\"})",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Total CPU cores",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Physical memory installed in all nodes, from node-exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum(node_memory_MemTotal_bytes)",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Total memory",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Combined capacity of the physical disks reported by smartctl, before RAID. Duplicates (for example the OS device and the RAID controller pass-through) are removed by serial number, and RAID virtual disks are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum(max by (node, serial_number) (smartctl_device_capacity_bytes{device!~\"^(loop|ram|sr|fd|dm-|zram|zd|nbd|rbd|drbd)[0-9]+$\"} * on (node, device) group_left (serial_number, model_name) smartctl_device{device!~\"^(loop|ram|sr|fd|dm-|zram|zd|nbd|rbd|drbd)[0-9]+$\", model_name!=\"IET VIRTUAL-DISK\", model_name!~\"(?i).*(perc|megaraid|serveraid|logical volume|virtual disk).*\"}))",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Raw disk capacity (before RAID)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Combined capacity of the whole block devices visible to the OS (node_disk_info), with each device's size taken from smartctl. On hardware-RAID machines this is the virtual disk, so it is the usable capacity after RAID.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum(smartctl_device_capacity_bytes and on (node, device) node_disk_info{device=~\"^(sd[a-z]+|hd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$\"})",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Disk capacity (after RAID)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Combined capacity of all disks managed by Longhorn, from longhorn-manager. Storage reservations are not subtracted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "light-blue"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "light-blue",
                "value": null
              }
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum(longhorn_disk_capacity_bytes)",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Longhorn capacity",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 101,
      "panels": [],
      "title": "Per-machine breakdown",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "description": "Per-node CPU, memory, OS-visible disk capacity, raw physical disk capacity and Longhorn capacity.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cores"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk after RAID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              },
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Raw disk"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Longhorn capacity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "count by (node) (node_cpu_seconds_total{mode=\"idle\"})",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum by (node) (node_memory_MemTotal_bytes)",
          "instant": true,
          "range": false,
          "refId": "B",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum by (node) (smartctl_device_capacity_bytes and on (node, device) node_disk_info{device=~\"^(sd[a-z]+|hd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$\"})",
          "instant": true,
          "range": false,
          "refId": "C",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum by (node) (max by (node, serial_number) (smartctl_device_capacity_bytes{device!~\"^(loop|ram|sr|fd|dm-|zram|zd|nbd|rbd|drbd)[0-9]+$\"} * on (node, device) group_left (serial_number, model_name) smartctl_device{device!~\"^(loop|ram|sr|fd|dm-|zram|zd|nbd|rbd|drbd)[0-9]+$\", model_name!=\"IET VIRTUAL-DISK\", model_name!~\"(?i).*(perc|megaraid|serveraid|logical volume|virtual disk).*\"}))",
          "instant": true,
          "range": false,
          "refId": "D",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "sum by (node) (longhorn_disk_capacity_bytes)",
          "instant": true,
          "range": false,
          "refId": "E",
          "format": "table"
        }
      ],
      "title": "Machines",
      "transformations": [
        {
          "id": "merge",
          "options": {
            "reducers": []
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Cores",
              "Value #B": "Memory",
              "Value #C": "Disk after RAID",
              "Value #D": "Raw disk",
              "Value #E": "Longhorn capacity"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Node",
                "desc": false
              }
            ]
          }
        }
      ],
      "type": "table"
    }
