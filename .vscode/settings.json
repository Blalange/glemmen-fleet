{
  "glemmenInventory.server.command": "uv",
  "glemmenInventory.server.args": [
    "run",
    "--with",
    "pygls>=2.1,<3",
    "--with",
    "lsprotocol",
    "--with",
    "PyYAML",
    "python",
    "inventory/scripts/inventory_lsp.py"
  ],
  "glemmenInventory.inventory": "inventory",
  "yaml.disableSchemaDetection": [
    "inventory/manual/**/*.yaml",
    "inventory/manual/**/*.yml",
    "inventory/generated/**/*.yaml",
    "inventory/generated/**/*.yml"
  ]
}
