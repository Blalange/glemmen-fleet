{
  "netboxInventory.server.command": "uvx",
  "netboxInventory.server.args": [
    "--python",
    "3.13",
    "--from",
    "netbox-inventory-toolkit[lsp]==0.2.1",
    "netbox-inventory-toolkit",
    "lsp"
  ],
  "netboxInventory.inventory": "inventory",
  "yaml.disableSchemaDetection": [
    "inventory/manual/**/*.yaml",
    "inventory/manual/**/*.yml",
    "inventory/generated/**/*.yaml",
    "inventory/generated/**/*.yml"
  ]
}
