# Shared settings for the Talos scripts in scripts/talos/.

# Versions
TALOS_VERSION=v1.14.2
KUBERNETES_VERSION=1.37.0

# Cluster
CLUSTER_NAME=glemmen
# Kubernetes API endpoint: Talos Layer2 VIP (advertised by the control plane nodes,
# taken over from keepalived's 192.168.6.99 which stays with the old cluster until cutover)
CLUSTER_ENDPOINT=https://192.168.6.98:6443 # kept in sync with the Layer2VIPConfig patch
CLUSTER_VIP=192.168.6.98

# Installer disk selector (CEL expression) used by UnattendedInstallConfig
INSTALL_DISK_SELECTOR='disk.dev_path == "/dev/sda"'

# Node table: name=ip. Used for apply/bootstrap/health calls.
TALOS_NODES="glemmen130=192.168.6.130 glemmen150=192.168.6.150 glemmen160=192.168.6.160 glemmen170=192.168.6.170 glemmen180=192.168.6.180 glemmen80=192.168.6.80 glemmen60=192.168.6.60 glemmen50=192.168.6.50"

# Worker-only nodes (the 1xx machines are control planes, these are not).
TALOS_WORKERS="glemmen80 glemmen60 glemmen50"

# First node to bootstrap etcd on
BOOTSTRAP_NODE=glemmen130
