# Python
__pycache__/
*.py[cod]
.venv/

# Network test results (CSV/PNG generated by scripts/network-test.py)
scripts/results/

# Talos: generated configs and secrets (tool binaries live in scripts/bin/)
talos/generated/
talos/secrets/*
!talos/secrets/README.md
!talos/secrets/netbird.env.example

# Flux bootstrap token (if stored locally)
flux/.env

# Longhorn backup credentials (never commit the real rclone config/secret)
rclone.conf
rclone-backup-config.yaml

# Migration helper state (kubeconfig, dumps, downloads)
scripts/migration-backup/
scripts/bin/

# Device Type Library runtime cache (never commit catalog data)
inventory/.dtl-cache/
