{
  "name": "glemmen-inventory",
  "displayName": "Glemmen inventory",
  "description": "Language support for the Glemmen Fleet inventory YAML files.",
  "version": "0.1.0",
  "publisher": "2ita",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "yaml",
    "inventory",
    "netbox",
    "language-server"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:inventory/manual"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "Glemmen inventory",
      "properties": {
        "glemmenInventory.server.command": {
          "type": "string",
          "default": "uv",
          "description": "Command used to start the inventory language server."
        },
        "glemmenInventory.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "run",
            "--with",
            "pygls>=2.1,<3",
            "--with",
            "lsprotocol",
            "--with",
            "PyYAML",
            "python",
            "inventory/scripts/inventory_lsp.py"
          ],
          "description": "Arguments passed to the language server command."
        },
        "glemmenInventory.server.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the language server. Defaults to the workspace folder."
        },
        "glemmenInventory.inventory": {
          "type": "string",
          "default": "",
          "description": "Optional inventory directory. Defaults to <workspace>/inventory."
        }
      }
    },
    "commands": [
      {
        "command": "glemmenInventory.restart",
        "title": "Glemmen inventory: Restart language server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository"
  }
}
