        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contactAssignment"
          }
