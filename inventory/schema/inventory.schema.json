        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "rackLayoutEntry": {
      "oneOf": [
        {
          "type": "object",
