        "snmp_interfaces": {
          "type": "boolean",
          "description": "Let SNMP own the device's physical interface list."
        },
        "snmp_cables": {
          "type": "boolean",
          "description": "Let SNMP generate cables from LLDP and forwarding-table observations."
        },
        "oob_ip": {
          "type": "string",
          "description": "Out-of-band management address. Must match an address declared on one of the device's interfaces."
        }
