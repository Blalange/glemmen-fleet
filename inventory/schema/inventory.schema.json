        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "module_bays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleBay"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "uplinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uplink"
          },
