          "type": "string",
          "description": "Collector identity locator: Talos node name."
        },
        "service_tag": {
          "type": "string",
          "description": "Collector identity: Dell service tag or equivalent stable hardware identifier."
        },
        "system_uuid": {
          "type": "string",
          "description": "Collector identity: hardware system UUID."
        },
        "unifi_ip": {
          "type": "string",
          "description": "Collector identity locator: UniFi client IP address."
        },
        "unifi_mac": {
          "$ref": "#/$defs/macAddress",
          "description": "Collector identity: UniFi client MAC address."
        },
        "unifi_serial": {
          "type": "string",
          "description": "Collector identity: UniFi device serial number."
        },
        "redfish_ip": {
          "type": "string",
          "description": "Collector locator: Redfish BMC address."
        },
        "ipmi_ip": {
          "type": "string",
          "description": "Collector locator: IPMI BMC address."
        },
        "snmp_ip": {
          "type": "string",
          "description": "Collector locator: SNMP management address."
