{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Keep this schema in sync with inventory/scripts/inventory_schema.py, inventory/scripts/sync_*.py and inventory/scripts/collector/*.py when adding or renaming fields.",
  "title": "Glemmen Fleet inventory",
  "description": "Schema for the manual and generated NetBox inventory. NetBox-backed fields are the fields written by inventory/scripts/sync_*.py; collector-only fields such as talos_node, redfish_ip, ipmi_ip, snmp_ip, unifi_ip, service_tag and oob_ip are accepted as custom inventory metadata.",
  "type": "object",
  "required": ["layer"],
  "properties": {
    "layer": {
      "$ref": "#/$defs/layer"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "unifi_models": {
      "$ref": "#/$defs/unifiModels"
    },
    "unifi_vlan_names": {
      "$ref": "#/$defs/unifiVlanNames"
    },
    "defaults": {
      "$ref": "#/$defs/deviceDefaults"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "manufacturers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manufacturer"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "device_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviceRole"
      }
    },
    "owner_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownerGroup"
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/owner"
      }
    },
    "contact_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contactRole"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "module_bay_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleBayType"
      }
    },
    "device_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviceType"
      }
    },
    "module_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleType"
      }
    },
    "racks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rack"
      }
    },
    "vlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan"
      }
    },
    "prefixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prefix"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "ip_addresses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standaloneIpAddress"
      }
    },
    "cables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cable"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layer": {
      "type": "string",
      "enum": ["manual", "generated"],
      "description": "Inventory layer. Manual files are hand-maintained; generated files are written by the collector and must not be edited by hand."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase slug used as a natural key in NetBox (letters, digits and single hyphens)."
    },
    "color": {
      "type": "string",
      "pattern": "^[0-9a-f]{6}$",
      "description": "Lowercase six-digit hexadecimal color, without a leading '#' (NetBox color format)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "NetBox tags. Provenance source tags are added separately from the sources list."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "manual",
          "generated",
          "unifi",
          "talos",
          "redfish",
          "ipmi",
          "snmp",
          "dtl"
        ]
      },
      "uniqueItems": true,
      "description": "Provenance sources. The loader adds manual to manual-layer objects; the collector records the live sources that contributed to generated objects."
    },
    "deviceStatus": {
      "type": "string",
      "enum": [
        "offline",
        "active",
        "planned",
        "staged",
        "failed",
        "inventory",
        "decommissioning"
      ],
      "description": "NetBox device status."
    },
    "moduleStatus": {
      "type": "string",
      "enum": [
        "offline",
        "active",
        "planned",
        "staged",
        "failed",
        "decommissioning"
      ],
      "description": "NetBox module status."
    },
    "siteStatus": {
      "type": "string",
      "enum": [
        "planned",
        "staging",
        "active",
        "decommissioning",
        "retired"
      ],
      "description": "NetBox site status."
    },
    "rackStatus": {
      "type": "string",
      "enum": [
        "reserved",
        "available",
        "planned",
        "active",
        "deprecated"
      ],
      "description": "NetBox rack status."
    },
    "vlanStatus": {
      "type": "string",
      "enum": [
        "active",
        "reserved",
        "deprecated"
      ],
      "description": "NetBox VLAN status."
    },
    "prefixStatus": {
      "type": "string",
      "enum": [
        "container",
        "active",
        "reserved",
        "deprecated"
      ],
      "description": "NetBox prefix status."
    },
    "ipAddressStatus": {
      "type": "string",
      "enum": [
        "active",
        "reserved",
        "deprecated",
        "dhcp",
        "slaac"
      ],
      "description": "NetBox IP address status."
    },
    "cableStatus": {
      "type": "string",
      "enum": [
        "connected",
        "planned",
        "decommissioning"
      ],
      "description": "NetBox cable status."
    },
    "contactPriority": {
      "type": "string",
      "enum": [
        "",
        "primary",
        "secondary",
        "tertiary",
        "inactive"
      ],
      "description": "NetBox contact assignment priority."
    },
    "deviceAirflow": {
      "type": "string",
      "enum": [
        "front-to-rear",
        "rear-to-front",
        "left-to-right",
        "right-to-left",
        "side-to-rear",
        "rear-to-side",
        "bottom-to-top",
        "top-to-bottom",
        "passive",
        "mixed"
      ],
      "description": "NetBox device-type airflow direction."
    },
    "weightUnit": {
      "type": "string",
      "enum": ["kg", "g", "lb", "oz"],
      "description": "NetBox weight unit."
    },
    "subdeviceRole": {
      "type": "string",
      "enum": ["", "parent", "child"],
      "description": "NetBox subdevice role. Empty means the device type is not a parent or child."
    },
    "face": {
      "type": "string",
      "enum": ["front", "rear"],
      "description": "Rack face the device is mounted on."
    },
    "interfaceMode": {
      "type": "string",
      "enum": [
        "",
        "access",
        "tagged",
        "tagged-all",
        "q-in-q"
      ],
      "description": "NetBox interface mode. Empty leaves the mode unset."
    },
    "rackWidth": {
      "type": "integer",
      "enum": [10, 19, 21, 23],
      "description": "NetBox rack width in inches."
    },
    "ipCidr": {
      "type": "string",
      "description": "IP address in CIDR notation, for example 192.168.6.130/24 or fd00::1/64."
    },
    "macAddress": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$",
      "description": "MAC address in colon-separated hexadecimal notation."
    },
    "settings": {
      "type": "object",
      "description": "Collector and sync settings. These keys are not synchronized to NetBox.",
      "properties": {
        "site": {
          "type": "string",
          "description": "Default site slug for collected devices."
        },
        "default_tag": {
          "type": "string",
          "description": "Tag added to every collected device."
        },
        "rack": {
          "type": "string",
          "description": "Default rack name used by the collector."
        }
      },
      "additionalProperties": false
    },
    "unifiModels": {
      "type": "object",
      "description": "UniFi model code to NetBox device-type slug mapping. Used by the collector.",
      "additionalProperties": {
        "$ref": "#/$defs/slug"
      }
    },
    "unifiVlanNames": {
      "type": "object",
      "description": "UniFi VLAN ID to corrected VLAN name mapping. Used by the collector.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "deviceDefaults": {
      "type": "object",
      "description": "Default device fields inherited by every device without an explicit value. Structural device fields (name, interfaces, module_bays, modules and uplinks) are not inherited.",
      "properties": {
        "site": {
          "$ref": "#/$defs/slug"
        },
        "role": {
          "$ref": "#/$defs/slug"
        },
        "device_type": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "$ref": "#/$defs/deviceStatus"
        },
        "platform": {
          "$ref": "#/$defs/slug"
        },
        "rack": {
          "type": "string"
        },
        "face": {
          "$ref": "#/$defs/face"
        },
        "serial": {
          "type": "string"
        },
        "asset_tag": {
          "type": ["string", "null"]
        },
        "owner": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contactAssignment"
          }
        },
        "talos_node": {
          "type": "string",
          "description": "Collector identity locator: Talos node name."
        },
        "service_tag": {
          "type": "string",
          "description": "Collector identity: Dell service tag or equivalent stable hardware identifier."
        },
        "system_uuid": {
          "type": "string",
          "description": "Collector identity: hardware system UUID."
        },
        "unifi_ip": {
          "type": "string",
          "description": "Collector identity locator: UniFi client IP address."
        },
        "unifi_mac": {
          "$ref": "#/$defs/macAddress"
        },
        "unifi_serial": {
          "type": "string",
          "description": "Collector identity: UniFi device serial number."
        },
        "redfish_ip": {
          "type": "string",
          "description": "Collector locator: Redfish BMC address."
        },
        "ipmi_ip": {
          "type": "string",
          "description": "Collector locator: IPMI BMC address."
        },
        "snmp_ip": {
          "type": "string",
          "description": "Collector locator: SNMP management address."
        },
        "snmp_interfaces": {
          "type": "boolean",
          "description": "Let SNMP own the device's physical interface list."
        },
        "snmp_cables": {
          "type": "boolean",
          "description": "Let SNMP generate cables from LLDP and forwarding-table observations."
        },
        "oob_ip": {
          "type": "string",
          "description": "Out-of-band management address. Must match an address declared on one of the device's interfaces."
        }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "$ref": "#/$defs/siteStatus"
        },
        "facility": {
          "type": "string",
          "description": "NetBox facility identifier."
        },
        "description": {
          "type": "string"
        },
        "physical_address": {
          "type": "string"
        },
        "shipping_address": {
          "type": "string"
        },
        "latitude": {
          "type": ["number", "null"]
        },
        "longitude": {
          "type": ["number", "null"]
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "manufacturer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "manufacturer": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "deviceRole": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "vm_role": {
          "type": "boolean",
          "description": "Whether this role may be assigned to virtual machines."
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "ownerGroup": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "description": "Owner group name."
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "contactRole": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "description": "URL for the contact."
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "moduleBayType": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "manufacturer": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "deviceType": {
      "type": "object",
      "required": ["manufacturer", "model"],
      "properties": {
        "manufacturer": {
          "$ref": "#/$defs/slug"
        },
        "model": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "dtl": {
          "type": "string",
          "description": "NetBox Device Type Library path, for example device-types/Dell/PowerEdge-R250.yml. The definition is fetched at sync time."
        },
        "u_height": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Height in rack units. Use 0 for non-rack devices."
        },
        "is_full_depth": {
          "type": "boolean",
          "default": true,
          "description": "Whether the device type occupies the full rack depth."
        },
        "part_number": {
          "type": "string"
        },
        "airflow": {
          "$ref": "#/$defs/deviceAirflow"
        },
        "weight": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "weight_unit": {
          "$ref": "#/$defs/weightUnit"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "subdevice_role": {
          "$ref": "#/$defs/subdeviceRole"
        },
        "images": {
          "$ref": "#/$defs/images"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interfaceTemplate"
          }
        },
        "console_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consolePortTemplate"
          }
        },
        "console_server_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consolePortTemplate"
          }
        },
        "power_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/powerPortTemplate"
          }
        },
        "power_outlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/powerPortTemplate"
          }
        },
        "rear_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontRearPortTemplate"
          }
        },
        "front_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontRearPortTemplate"
          }
        },
        "module_bays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleBayTemplate"
          }
        },
        "device_bays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceBayTemplate"
          }
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "moduleType": {
      "type": "object",
      "required": ["manufacturer", "model", "profile"],
      "properties": {
        "manufacturer": {
          "$ref": "#/$defs/slug"
        },
        "model": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "profile": {
          "type": "string",
          "description": "NetBox module type profile name, for example CPU, Memory, Hard disk, Fan, Power supply or Expansion card."
        },
        "dtl": {
          "type": "string",
          "description": "NetBox Device Type Library path for a module type definition."
        },
        "part_number": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "weight": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "weight_unit": {
          "$ref": "#/$defs/weightUnit"
        },
        "attributes": {
          "$ref": "#/$defs/moduleTypeAttributes"
        },
        "bay_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Module bay type slugs this module type can be installed in. NetBox calls these module bay types."
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interfaceTemplate"
          }
        },
        "console_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consolePortTemplate"
          }
        },
        "console_server_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consolePortTemplate"
          }
        },
        "power_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/powerPortTemplate"
          }
        },
        "power_outlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/powerPortTemplate"
          }
        },
        "rear_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontRearPortTemplate"
          }
        },
        "front_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontRearPortTemplate"
          }
        },
        "module_bays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleBayTemplate"
          }
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      },
      "additionalProperties": false
    },
    "rack": {
      "type": "object",
      "required": ["name", "site"],
      "properties": {
        "name": {
          "type": "string"
        },
        "site": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "$ref": "#/$defs/rackStatus"
        },
        "width": {
          "$ref": "#/$defs/rackWidth"
        },
        "u_height": {
          "type": "integer",
          "minimum": 1,
          "default": 42
        },
        "desc_units": {
          "type": "boolean",
          "default": false,
          "description": "Whether rack units are numbered from the top down."
        },
        "facility_id": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "asset_tag": {
          "type": ["string", "null"]
        },
        "description": {
