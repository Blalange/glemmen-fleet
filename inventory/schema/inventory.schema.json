    "moduleTypeAttributes": {
      "type": "object",
      "description": "Profile-specific NetBox module type attributes. The available keys are defined by the module type profile's JSON schema in NetBox; the properties below cover the profiles used in this repository and their DTL equivalents.",
      "properties": {
        "architecture": {
          "type": "string",
          "description": "CPU architecture, for example x86-64 or ARM."
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "description": "CPU core count."
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "CPU clock speed in GHz, or disk rotation speed in RPM for Hard disk profiles."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Capacity in GB for memory and disk profiles."
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "description": "Capacity in GB. Alias used by some DTL disk definitions."
        },
        "class": {
          "type": "string",
          "enum": ["DDR3", "DDR4", "DDR5"],
          "description": "Memory class."
        },
        "ecc": {
          "type": "boolean",
          "description": "Whether memory has ECC."
        },
        "data_rate": {
          "type": "integer",
          "minimum": 0,
          "description": "Memory data rate in MT/s."
        },
        "type": {
          "type": "string",
          "enum": ["HD", "SSD", "NVME"],
          "description": "Disk type."
        },
        "disk_type": {
          "type": "string",
          "enum": ["HD", "SSD", "NVME"],
          "description": "Disk type. Alias used by some DTL disk definitions."
        },
        "rpm": {
          "type": "integer",
          "minimum": 0,
          "description": "Fan speed in RPM."
        },
        "wattage": {
          "type": "integer",
          "minimum": 0,
          "description": "Power supply output in watts."
        },
        "input_current": {
          "type": "string",
          "enum": ["AC", "DC"],
          "description": "Power supply input current."
        },
        "input_voltage": {
          "type": "number",
          "minimum": 0,
          "description": "Power supply input voltage."
        },
        "hot_swappable": {
          "type": "boolean",
          "description": "Whether the power supply is hot-swappable."
        },
        "connector_type": {
          "type": "string",
          "description": "Expansion card connector type, for example PCIe, SAS or QSFP+."
        },
        "bandwidth": {
          "type": "integer",
          "minimum": 0,
          "description": "Expansion card bandwidth in Gbps."
        },
        "gpu": {
          "type": "string",
          "description": "GPU model or type."
        },
        "interface": {
          "type": "string",
          "description": "GPU interface, for example PCIe 4.0 x16."
        },
        "memory": {
          "type": "integer",
          "minimum": 0,
          "description": "GPU memory in GB."
        }
      },
      "additionalProperties": true
    }
  }
